# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=app...
GRANOLA_API_KEY=...           # only if on Business plan and using API
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
# Mint this refresh token with READ-ONLY scopes only. The token's granted scope is the
# real security boundary: with read-only it cannot send, draft, modify, or delete, even
# if the MCP server exposes those tools. Required scopes:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/calendar.readonly
GOOGLE_OAUTH_REFRESH_TOKEN=...
