# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=app...
GRANOLA_API_KEY=...           # only if on Business plan and using API

# Google Calendar (gcal MCP) uses these three env vars. Mint the refresh token with the
# READ-ONLY scope only. The granted scope is the real boundary: read-only cannot mutate.
#   https://www.googleapis.com/auth/calendar.readonly
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REFRESH_TOKEN=...

# Gmail (gmail MCP, @klodr/gmail-mcp) does NOT use env vars for auth. It uses a one-time
# file-based OAuth flow scoped read-only. See README "Gmail setup":
#   npx -y @klodr/gmail-mcp auth --scopes=gmail.readonly
# A read-only token means the server never even registers write tools for the agent.
